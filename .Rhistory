rm(list=ls(all=TRUE))
library(boa)
library(coda)
zz<-10;
#Under SELF
a1_SELF<- rep(0,zz);l1_SELF<- rep(0,zz);a2_SELF<- rep(0,zz);l2_SELF<- rep(0,zz);
s_SELF<- rep(0,zz);
#Under ELF
a1_ELF<- rep(0,zz);l1_ELF<- rep(0,zz);a2_ELF<- rep(0,zz);l2_ELF<- rep(0,zz);
s_ELF<- rep(0,zz);
#Under PLF
a1_PLF<- rep(0,zz);l1_PLF<- rep(0,zz);a2_PLF<- rep(0,zz);l2_PLF<- rep(0,zz);
s_PLF<- rep(0,zz);
for(kk in 1:zz)
{
th1=0.5;th2=1.5; dl=-0.1  ## true parameter
n=20
x1=c(); y1=c(); u=c();t=c();v=c();
############## sample generation ############
for( i in 1:n){
u[i]=runif(1,0,1)
t[i]=runif(1,0,1)
#v=1-((t-1)/(dl*(1-2*u)))
f=function(vv){vv+(dl/pi)*sin(pi*vv)*cos(pi*u[i])-t[i]}
v[i]=uniroot(f, lower =0, upper = 1)$root
fx<-function(x){1-u[i]-exp((th1*x)-exp(th1*x)+1)}
x1[i]<- uniroot(fx, lower =0, upper = 1000)$root
fy<-function(y){1-v[i]-exp((th2*y)-exp(th2*y)+1)}
y1[i]<- uniroot(fy, lower =0, upper = 1000)$root
}
x1
y1
